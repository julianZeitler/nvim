{
  "environment": {
    "prefix": "beg",
    "body": ["\\begin{$1}", "\t$0", "\\end{$1}"],
    "description": "Generic environment (name mirrors into \\end)"
  },
  "equation": {
    "prefix": "eq",
    "body": ["\\begin{equation}", "\t\\label{eq:$1}", "\t$0", "\\end{equation}"],
    "description": "Numbered equation with label"
  },
  "equation unnumbered": {
    "prefix": "eq*",
    "body": ["\\begin{equation*}", "\t$0", "\\end{equation*}"],
    "description": "Unnumbered equation"
  },
  "align": {
    "prefix": "align",
    "body": ["\\begin{align}", "\t$1 &= $2 \\\\\\\\", "\t$0", "\\end{align}"],
    "description": "Aligned multi-line equations"
  },
  "figure": {
    "prefix": "fig",
    "body": [
      "\\begin{figure}[t]",
      "\t\\centering",
      "\t\\includegraphics[width=\\linewidth]{$1}",
      "\t\\caption{$2}",
      "\t\\label{fig:$3}",
      "\\end{figure}",
      "$0"
    ],
    "description": "Figure in one column (\\linewidth, not \\textwidth)"
  },
  "figure full width": {
    "prefix": "figw",
    "body": [
      "\\begin{figure*}[t]",
      "\t\\centering",
      "\t\\includegraphics[width=\\textwidth]{$1}",
      "\t\\caption{$2}",
      "\t\\label{fig:$3}",
      "\\end{figure*}",
      "$0"
    ],
    "description": "Figure spanning both columns (top of page only)"
  },
  "table": {
    "prefix": "tab",
    "body": [
      "\\begin{table}[t]",
      "\t\\centering",
      "\t\\caption{$1}",
      "\t\\label{tab:$2}",
      "\t\\begin{tabular}{$3}",
      "\t\t\\toprule",
      "\t\t$4 \\\\\\\\",
      "\t\t\\midrule",
      "\t\t$0 \\\\\\\\",
      "\t\t\\bottomrule",
      "\t\\end{tabular}",
      "\\end{table}"
    ],
    "description": "Table with booktabs rules"
  },
  "itemize": {
    "prefix": "item",
    "body": ["\\begin{itemize}", "\t\\item $0", "\\end{itemize}"],
    "description": "Bulleted list"
  },
  "enumerate": {
    "prefix": "enum",
    "body": ["\\begin{enumerate}", "\t\\item $0", "\\end{enumerate}"],
    "description": "Numbered list"
  },
  "section": {
    "prefix": "sec",
    "body": ["\\section{$1}", "\\label{sec:$2}", "", "$0"],
    "description": "Section with label"
  },
  "subsection": {
    "prefix": "sub",
    "body": ["\\subsection{$1}", "\\label{sec:$2}", "", "$0"],
    "description": "Subsection with label"
  }
}
